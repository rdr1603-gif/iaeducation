# ---------------------------------------------------------------------------
# Articula Educación IA — variables de entorno
# ONIX Production
#
# Copiá este archivo a `.env.local` y completá los valores.
# NUNCA commitees `.env.local`: sólo `.env.example` va al repositorio.
# ---------------------------------------------------------------------------

# --- Aplicación -----------------------------------------------------------
# URL pública de la app (sin barra final).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Articula Educación IA
NODE_ENV=development

# --- Base de datos (Supabase Postgres) ------------------------------------
# `DIRECT_DATABASE_URL`: conexión directa (puerto 5432). La usan las MIGRACIONES.
# No puede ser el pooler de transacciones (6543): el pooler no admite DDL.
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# `DATABASE_URL`: conexión que usa la aplicación en runtime.
# En producción conviene el pooler de transacciones (6543) para ahorrar conexiones.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Supabase Auth + Storage ----------------------------------------------
# Proyecto: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role: SOLO servidor. Da acceso total, ignora RLS y saltea la sesión.
# Si se filtra, rotalo inmediatamente en el panel de Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bucket de Supabase Storage para los documentos de planificación.
# Crear como PRIVADO. Nunca hacerlo público: los documentos son institucionales.
# `NEXT_PUBLIC_` sólo replica el nombre (no es un secreto) para que el cliente
# pueda armar URLs consistentes con el servidor.
STORAGE_BUCKET=articula-documents
NEXT_PUBLIC_STORAGE_BUCKET=articula-documents

# --- Cifrado de secretos --------------------------------------------------
# AES-256-GCM para cifrar API keys de IA y configuraciones de integración
# por institución. 64 caracteres hexadecimales (32 bytes).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Inteligencia artificial ----------------------------------------------
# Proveedor por defecto a nivel plataforma. Cada institución puede sobrescribirlo
# en Configuración → IA; en ese caso manda la configuración de la institución.
# Valores: NONE | OPENAI_COMPATIBLE | OLLAMA
AI_PROVIDER=NONE

# Endpoint y modelos. Para OpenAI: base https://api.openai.com/v1
AI_BASE_URL=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# Debe coincidir con la dimensión de la columna `vector(...)` (1536 por defecto).
AI_EMBEDDING_DIMENSIONS=1536
AI_API_KEY=

# --- Tareas programadas (Vercel Cron) -------------------------------------
# Secreto para autenticar las rutas de cron. Mínimo 16 caracteres.
CRON_SECRET=

# --- Observabilidad -------------------------------------------------------
LOG_LEVEL=info
